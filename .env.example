# framework.sdd.works — env codes only (no secrets). Copy to .env.local and fill.
# See specs/tech-spec.md. Do not commit filled values.

# App
APP_NAME=framework.sdd.works
PORT=3000
PUBLIC_BASE_URL=http://localhost:3040
SESSION_SECRET=

# Default admin seed (SEED-01) — operator fills password; do not commit secrets
ADMIN_SEED_EMAIL=me@ethanhuang.com
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=

# Qwen (MCP path discovery — ADR-047; Sprint 6+)
QWEN_API_KEY=
QWEN_HOST=
QWEN_BASE_URL=
QWEN_NATIVE_BASE_URL=
QWEN_WORKSPACE=
QWEN_REGION=
QWEN_CHAT_MODEL=qwen-plus
QWEN_CHAT_MODEL_FALLBACK=
QWEN_IMAGE_MODEL=
QWEN_KEY_MGMT_SITE=

# Postgres — local for .env.local; AliCloud URL only on Server 2 / Portainer
DATABASE_URL=postgresql://framework_sdd:framework_sdd@localhost:5435/framework_sdd

# MCP HTTP
MCP_HTTP_PATH=/mcp
MCP_HTTP_PORT=3041
MCP_AUTH_TOKEN=

# GitHub (server-side, read-only)
GITHUB_TOKEN=
GITHUB_API_HOST=api.github.com
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEBHOOK_SECRET=

# Mail
RESEND_API_KEY=
RESEND_HOST=api.resend.com
RESEND_BASE_URL=
RESEND_KEY_MGMT_SITE=
MAIL_FROM=
SMTP_URL=

# Optional: encrypt key_value at rest
KEYS_ENCRYPTION_KEY=
