generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminStatus {
  ACTIVE
  DEACTIVATED
}

model Admin {
  id             String      @id @default(cuid())
  email          String      @unique
  username       String      @unique
  name           String
  passwordHash   String      @default("")
  status         AdminStatus @default(ACTIVE)
  sessionVersion Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  resetTokens    ResetToken[]
  invitesSent    InviteToken[] @relation("InvitedBy")
}

model ResetToken {
  id        String    @id @default(cuid())
  adminId   String
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

model InviteToken {
  id         String    @id @default(cuid())
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  invitedBy  String
  inviter    Admin     @relation("InvitedBy", fields: [invitedBy], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([invitedBy])
}

model Key {
  keyId          String   @id @default(uuid()) @map("key_id")
  keyName        String   @unique @map("key_name")
  keyDescription String   @map("key_description")
  keyValue       String   @map("key_value")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("keys")
}

model Setting {
  id        String   @id @default("singleton")
  githubUrl String?
  updatedBy String?
  updatedAt DateTime @updatedAt
}
