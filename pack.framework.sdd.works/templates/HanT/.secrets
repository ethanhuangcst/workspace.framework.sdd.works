# [product name] — 僅金鑰名稱。值一律留空。不要提交真實 key、token 或密碼。
# 值存放位置：行尾 # 註解（例如 .env.local、Portainer、CI secret）。
# 已填寫的值只放在 gitignore 的檔案裡（.env.local、主機上的維運環境變數）。
# 可選工件。見 sdd-scrum-practices.md 中 .secrets 小節與 release.md。

# Database
DATABASE_URL=  # .env.local 或 Portainer

# Auth and encryption
SESSION_SECRET=  # .env.local 或 Portainer
KEYS_ENCRYPTION_KEY=  # Portainer

# Third-party APIs
OPENAI_API_KEY=  # .env.local
RESEND_API_KEY=  # Portainer

# Deploy, CI, and service-to-service
GITHUB_TOKEN=  # GitHub Actions secret
CRON_SECRET=  # Portainer
MCP_AUTH_TOKEN=  # Portainer（web 與 MCP 棧）

# One-time bootstrap（首次管理員登入後刪除或輪換，若產品需要）
ADMIN_SEED_PASSWORD=  # 首次部署時在 Portainer 設定

# {SECRET_NAME}=  # {值存放位置}
