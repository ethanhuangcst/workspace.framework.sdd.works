# [product name] — 仅密钥名称。值一律留空。不要提交真实 key、token 或密码。
# 值存放位置：行尾 # 注释（例如 .env.local、Portainer、CI secret）。
# 已填写的值只放在 gitignore 的文件里（.env.local、主机上的运维环境变量）。
# 可选工件。见 sdd-scrum-practices.md 中 .secrets 小节与 release.md。

# Database
DATABASE_URL=  # .env.local 或 Portainer

# Auth and encryption
SESSION_SECRET=  # .env.local 或 Portainer
KEYS_ENCRYPTION_KEY=  # Portainer

# Third-party APIs
OPENAI_API_KEY=  # .env.local
RESEND_API_KEY=  # Portainer

# Deploy, CI, and service-to-service
GITHUB_TOKEN=  # GitHub Actions secret
CRON_SECRET=  # Portainer
MCP_AUTH_TOKEN=  # Portainer（web 与 MCP 栈）

# One-time bootstrap（首次管理员登录后删除或轮换，若产品需要）
ADMIN_SEED_PASSWORD=  # 首次部署时在 Portainer 设置

# {SECRET_NAME}=  # {值存放位置}
