{
  "name": "framework.sdd.works",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev app/web -p 3040",
    "build": "next build app/web",
    "start": "next start app/web -p 3000",
    "check:pack-seeds": "bash scripts/check-pack-seed-links.sh",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p app/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:regression:freshness": "vitest run app/shared/core/sync/freshness-regression.test.ts app/shared/core/sync/package-content.test.ts app/shared/core/sync/sync-e2e.test.ts app/shared/core/sync/ensure-cache-fresh.test.ts app/shared/core/sync/run-scheduled-sync.test.ts app/web/app/api/github/webhook/route.test.ts app/web/app/api/sync/cron/route.test.ts",
    "mcp:http": "tsx --env-file=.env.local app/mcp/http-server.ts",
    "db:generate": "prisma generate --schema=app/shared/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=app/shared/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema=app/shared/prisma/schema.prisma",
    "db:seed": "prisma db seed --schema=app/shared/prisma/schema.prisma",
    "postinstall": "prisma generate --schema=app/shared/prisma/schema.prisma"
  },
  "prisma": {
    "schema": "app/shared/prisma/schema.prisma",
    "seed": "npx tsx app/shared/prisma/seed.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octokit/rest": "^22.0.0",
    "@prisma/client": "^6.16.0",
    "@sdd/paths": "*",
    "@tanstack/react-query": "^5.101.4",
    "express": "^5.2.1",
    "marked": "^18.0.14",
    "next": "16.3.0",
    "prisma": "^6.16.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "resend": "^6.0.0",
    "tsx": "^4.20.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "bun": "^1.2.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.3.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
