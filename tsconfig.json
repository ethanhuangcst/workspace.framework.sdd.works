{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowJs": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@web/*": ["app/web/*"],
      "@mcp/*": ["app/mcp/*"],
      "@shared/*": ["app/shared/*"],
      "@sdd/paths": ["app/shared/packages/sdd-paths"],
      "@sdd/paths/*": ["app/shared/packages/sdd-paths/*"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "app/shared/messages/**/*.json"],
  "exclude": ["node_modules", "**/.next"]
}
