# framework.sdd.works — production env names only (Portainer stack).
# Copy names into Portainer; never commit filled values.

# Image (GHCR tag — git sha preferred; not branch name "main")
IMAGE_TAG=

# Core
NODE_ENV=production
APP_NAME=framework.sdd.works
PUBLIC_BASE_URL=https://framework.sdd.works

# Web listen
PORT=3000
HOSTNAME=0.0.0.0

# Database (Aliyun Postgres — dedicated framework_sdd)
DATABASE_URL=

# Admin bootstrap (SEED-01 — ADMIN_SEED_PASSWORD required)
ADMIN_SEED_EMAIL=me@ethanhuang.com
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=

# Session + keys encryption (KEYS_ENCRYPTION_KEY immutable after first Keys write)
SESSION_SECRET=
KEYS_ENCRYPTION_KEY=

# GitHub sync (contents:read on framework package source repo)
GITHUB_TOKEN=
GITHUB_API_HOST=api.github.com
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEBHOOK_SECRET=
CRON_SECRET=

# MCP HTTP (sibling container)
MCP_AUTH_TOKEN=
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3041
MCP_HTTP_PATH=/mcp
SDD_SERVER_URL=https://framework.sdd.works

# SYNK package cache (compose volume mount)
SDD_PACKAGE_CACHE_DIR=/data/sdd-packages

# Mail (P1 — password reset / invite)
RESEND_API_KEY=
RESEND_HOST=api.resend.com
RESEND_BASE_URL=https://api.resend.com
RESEND_KEY_MGMT_SITE=
MAIL_FROM=
SMTP_URL=
